# brrragent API keys (comma-separated for rotation)
#
# Smart routing: if model starts with "google/" and GEMINI_API_KEY is set,
# uses Google Gemini API directly (no OpenRouter premium).
# Otherwise falls back to OpenRouter.

# OpenRouter (fallback)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Google Gemini direct (preferred for google/* models)
GEMINI_API_KEY=AIzaSy-your-key-1,AIzaSy-your-key-2

# MCP endpoint (optional, defaults to https://crawlers.brunocvcunha.workers.dev/mcp)
# MCP_CRAWLERS_URL=https://crawlers.brunocvcunha.workers.dev/mcp
